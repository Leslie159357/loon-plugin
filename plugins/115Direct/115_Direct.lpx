#!name = 115 网盘直连
#!desc = 115 全系域名直连（拾光Next 公告域名 + blackmatrix7 补充），避免 115 挂梯后播放/下载失败
#!author = ox-alpha
#!homepage = https://github.com/blackmatrix7/ios_rule_script
