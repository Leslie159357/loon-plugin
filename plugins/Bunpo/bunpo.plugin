#!name=Bunpo Plus Unlocker
#!desc=劫持 Bunpo 课程解锁（100% 对齐 Cake 成功架构：force_plain 强制明文 + 后端接口 locked 字段递归抹平 + RevenueCat 会员注入）
#!author=Leslie159357
#!homepage=https://github.com/Leslie159357/loon-plugin
#!icon=https://assets.bunpo.app/image/language/round/de.png
#!version=14.0.0
#!date=2026-10-03
#!tag=订阅|解锁|bunpo

[Script]
# 请求阶段：强制明文，剥离 gzip 与 304 缓存
http-request ^https?:\/\/[^/]*(revenuecat\.com|rc-backup\.com|run\.app|bunpo\.app)[^/]*\/ script-path=https://testingcf.jsdelivr.net/gh/Leslie159357/loon-plugin@373723c85c2debb21ba756107dc5f14a2f6d86b1/plugins/Bunpo/force_plain.js, timeout=5, tag=Bunpo ForcePlain

# 响应阶段：100% 对齐 Cake 树状递归解密（解开课程目录 + 课文题库 + 会员权限）
http-response ^https?:\/\/[^/]*(revenuecat\.com|rc-backup\.com|run\.app|bunpo\.app)[^/]*\/ script-path=https://testingcf.jsdelivr.net/gh/Leslie159357/loon-plugin@373723c85c2debb21ba756107dc5f14a2f6d86b1/plugins/Bunpo/bunpo.js, requires-body=true, timeout=15, tag=Bunpo Plus 解锁

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api-paywalls.revenuecat.com, bunpo-basic-283414158288.us-central1.run.app, *.run.app, *.bunpo.app
