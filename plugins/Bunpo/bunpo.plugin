#!name = Bunpo Plus/Platinum 解锁
#!desc = 解锁 Bunpo 全语言全课程（德语/日语等语法、单词、听力练习与离线内容）- 支持 Request 阶段 Mock 绕过 304 缓存
#!author = Leslie159357
#!icon = https://assets.bunpo.app/image/language/round/de.png
#!date = 2026-10-03
#!version = 2.0.0

[MITM]
hostname = %APPEND% api.revenuecat.com

[Script]
http-request ^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$) script-path = https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/Bunpo/bunpo.js, timeout = 10, tag = Bunpo - 权限解锁 (Request)
http-response ^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$) script-path = https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/Bunpo/bunpo.js, requires-body = true, timeout = 10, tag = Bunpo - 权限解锁 (Response)
