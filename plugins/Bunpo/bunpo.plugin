#!name=Bunpo Pro & Platinum Unlock
#!desc=Bunpo 会员解锁（RevenueCat MITM 定制版 — 100% 对齐 TheGreatMe 实战成功架构）
#!author=Leslie159357
#!homepage=https://github.com/Leslie159357/loon-plugin
#!version=12.0.0
#!date=2026-10-03
#!tag=premium,unlock,bunpo,revenuecat

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com, api-paywalls.revenuecat.com, api-diagnostics.revenuecat.com
skip_validation = true

[Script]
http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts) script-path = https://testingcf.jsdelivr.net/gh/Leslie159357/loon-plugin@6979c792f04e5678de356cc175fe8dae3efce8fc/plugins/Bunpo/bunpo.js, timeout=10, tag=Bunpo_RC_Req
http-response ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts) requires-body = true, script-path = https://testingcf.jsdelivr.net/gh/Leslie159357/loon-plugin@6979c792f04e5678de356cc175fe8dae3efce8fc/plugins/Bunpo/bunpo.js, timeout=10, tag=Bunpo_RC_Resp
