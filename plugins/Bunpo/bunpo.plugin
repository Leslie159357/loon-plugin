#!name=Bunpo Plus/Platinum 解锁
#!desc=Bunpo 会员解锁（RevenueCat 定制版）— 永久解锁 Plus & Platinum 全语言全课程
#!author=Leslie159357
#!homepage=https://github.com/Leslie159357/loon-plugin
#!version=6.0.0
#!date=2026-10-03
#!tag=premium,unlock,bunpo,revenuecat

[MITM]
hostname = api.revenuecat.com, api.rc-backup.com, api-paywalls.revenuecat.com, api-diagnostics.revenuecat.com
skip_validation = true

[Script]
http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts) script-path = https://testingcf.jsdelivr.net/gh/Leslie159357/loon-plugin@ba1e54fd4d5567e47368b0bc1963dca8dfff3b3c/plugins/Bunpo/bunpo.js, timeout=10, tag=Bunpo_RC_Req
http-response ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts) requires-body = true, script-path = https://testingcf.jsdelivr.net/gh/Leslie159357/loon-plugin@ba1e54fd4d5567e47368b0bc1963dca8dfff3b3c/plugins/Bunpo/bunpo.js, timeout=10, tag=Bunpo_RC_Resp
