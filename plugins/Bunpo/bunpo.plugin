[MITM]
hostname = api.revenuecat.com, api.rc-backup.com, api-paywalls.revenuecat.com

[Script]
http-request ^https?:\/\/api\.revenuecat\.com\/v1\/subscribers script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/Bunpo/bunpo.js, requires-body=true, timeout=10, tag=Bunpo Request
http-response ^https?:\/\/api\.revenuecat\.com\/v1\/subscribers script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/Bunpo/bunpo.js, requires-body=true, timeout=10, tag=Bunpo Response
