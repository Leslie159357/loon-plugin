[Script]
# Cake 后端订阅接口：记录 + 伪造（v1 试探版）
http-response ^https?:\/\/[^/]*(d162pjbd816bzl\.cloudfront\.net|mycake\.plus|cake\.day)[^/]*\/.*(subscription|entitlement|verifyReceipt|membership) script-path=https://testingcf.jsdelivr.net/gh/Leslie159357/loon-plugin@main/plugins/Cake/cake.js, requires-body=true, timeout=15, tag=Cake Plus 解锁

[MITM]
hostname = %APPEND% d162pjbd816bzl.cloudfront.net, api.mycake.plus, *.mycake.plus, *.cake.day, static-mycake.pstatic.net
