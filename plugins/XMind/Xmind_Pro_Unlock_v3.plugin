#!name=Xmind Pro+ 解锁 v3
#!desc=Xmind iOS Pro Plus 会员解锁插件 v3（真实抓包修正：www.xmind.cn 接口逐一匹配）
#!author=Minis
#!home=https://github.com/Leslie159357/loon-plugin
#!icon=https://www.xmind.cn/favicon.ico
#!version=3.0
#!date=2026-08-20

[MITM]
hostname = %APPEND% www.xmind.cn, app.xmind.com, app.xmind.cn, templates-api.xmind.com

[Script]
# 订阅详情（数组注入）
http-response ^https?://www\.xmind\.cn/_res/user_sub_details script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=Xmind SubDetails

# App Store 订阅状态
http-response ^https?://www\.xmind\.cn/_api/appstore/active script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=Xmind AppstoreActive

# App Store 订阅提交（伪造成功）
http-response ^https?://www\.xmind\.cn/_res/appstore/sub script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=Xmind AppstoreSub

# 设备 License
http-response ^https?://www\.xmind\.cn/_res/devices script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=Xmind Devices

# Session
http-response ^https?://www\.xmind\.cn/_res/session script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=Xmind Session
