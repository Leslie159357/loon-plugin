#!name=Xmind Pro+ 解锁
#!desc=解锁 Xmind Pro/ProPlus 会员（假订阅，改写 www.xmind.cn 会员接口）
#!author=Minis
#!home=https://github.com/Leslie159357/loon-plugin
#!icon=https://www.xmind.cn/favicon.ico
#!version=4.0
#!date=2026-08-21

[Script]
http-response ^https?://www\.xmind\.cn/_res/user_sub_details script-path=https://raw.githubusercontent.com/Leslie159357/Loon-Plugins/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=XmindSubDetails
http-response ^https?://www\.xmind\.cn/_api/appstore/active script-path=https://raw.githubusercontent.com/Leslie159357/Loon-Plugins/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=XmindAppstoreActive
http-response ^https?://www\.xmind\.cn/_res/appstore/sub script-path=https://raw.githubusercontent.com/Leslie159357/Loon-Plugins/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=XmindAppstoreSub
http-response ^https?://www\.xmind\.cn/_res/devices script-path=https://raw.githubusercontent.com/Leslie159357/Loon-Plugins/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=XmindDevices
http-response ^https?://www\.xmind\.cn/_res/session script-path=https://raw.githubusercontent.com/Leslie159357/Loon-Plugins/main/plugins/XMind/xmind_unlock_v3.js, requires-body=true, timeout=10, tag=XmindSession

[MITM]
hostname = www.xmind.cn
