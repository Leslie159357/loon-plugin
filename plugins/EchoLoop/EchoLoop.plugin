#!name=EchoLoop Premium 解锁
#!desc=解锁 EchoLoop 英语学习 app 的全部 Premium 功能 — 后端 API 通用注入（entitlements/premium/config）
#!author=Minis
#!home=https://github.com/Leslie159357/loon-plugin/tree/main/plugins/EchoLoop
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/c9/5b/a4/c95ba48e-6360-4697-aba7-c1a1e1e80dcb/AppIcon-0-0-1x_U007emarketing-0-7-0-0-0-85-220-0.png/512x512bb.png
#!system=ios
#!date=2026-08-13
#!version=1.0
#!tag=unlock,英语,学习,premium

[Script]
# 后端 entitlement / 配置注入
http-response ^https?:\/\/www\.echo-loop\.top\/(api\/entitlements|api\/v1\/client\/config) script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/EchoLoop/echoloop.js, requires-body=true, timeout=10, tag=EchoLoop Inject Premium

# 兜底: 任何含 entitlement/premium/plan 的响应
http-response ^https?:\/\/www\.echo-loop\.top\/.*(entitlement|premium|plan) script-path=https://raw.githubusercontent.com/Leslie159357/loon-plugin/main/plugins/EchoLoop/echoloop.js, requires-body=true, timeout=10, tag=EchoLoop Inject Backup

[MITM]
hostname = %APPEND% www.echo-loop.top
