#!name=TheGreatMe Premium Unlock
#!desc=TheGreatMe 会员解锁（RevenueCat MITM 定制版）— 永久解锁 premium
#!author=Leslie159357
#!version=2.0.0

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api-paywalls.revenuecat.com, api-diagnostics.revenuecat.com

[Script]
http-response ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts|product_entitlement_mapping|offerings) requires-body = 1, script-path = tgme_premium.js
http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts) script-path = tgme_premium.js
