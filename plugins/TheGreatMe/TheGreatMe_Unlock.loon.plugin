#!name=TheGreatMe Premium Unlock
#!desc=TheGreatMe 会员解锁（RevenueCat MITM 定制版）— 永久解锁 premium
#!author=Leslie159357
#!homepage=https://github.com/Leslie159357/loon-plugin
#!version=2.0.0
#!date=2026-08-14
#!tag=premium,unlock,thegreatme,revenuecat

[General]
skip_proxy = *.revenuecat.com, *.rc-backup.com

[MITM]
hostname = *.revenuecat.com, *.rc-backup.com, api-paywalls.revenuecat.com, api-diagnostics.revenuecat.com
skip_validation = true

[Script]
http-response ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts|product_entitlement_mapping|offerings) requires-body = true, script-path = tgme_premium.js, timeout=10, tag=TheGreatMe_RC
http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/|receipts) script-path = tgme_premium.js, timeout=10, tag=TheGreatMe_Etag
